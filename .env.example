# Copy to .env and change the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# --- Database ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blog
# Separate database used by the backend test suite
POSTGRES_TEST_DB=blog_test
# Host port for Postgres (change if 5432 is already in use)
POSTGRES_PORT=5432

# --- API ---
# Host port for the API (change if 8000 is already in use)
API_PORT=8000
