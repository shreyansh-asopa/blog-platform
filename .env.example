# Copy to .env and change the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# --- Database ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blog
# Separate database used by the backend test suite
POSTGRES_TEST_DB=blog_test
# Host port for Postgres (change if 5432 is already in use)
POSTGRES_PORT=5432

# --- Auth ---
# Secret key that signs login tokens (at least 32 characters). Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Comment moderation ---
# Leave unset to use the built-in word list (free, offline). Set a URL to send
# comments to an external API instead: POST {"text": ...} -> {"flagged": bool, "reason": ...}
# If that API is down, comments are accepted unchecked and a warning is logged.
# MODERATION_API_URL=https://moderation.example.com/check
# MODERATION_API_KEY=
# MODERATION_TIMEOUT_SECONDS=3
# MODERATION_RETRIES=2

# --- AI writing help ---
# The editor's AI panel uses Claude by default. Create a key at
# https://console.anthropic.com/settings/keys and set it here (posts are sent to
# Anthropic to get suggestions; usage is billed to that key).
ANTHROPIC_API_KEY=
# AI_PROVIDER=claude
# AI_MODEL=claude-sonnet-5        # e.g. claude-haiku-4-5 costs less
#
# Free alternative: AI_PROVIDER=ollama runs a model on this machine with Ollama
# (https://ollama.com, then: ollama pull llama3.1:8b, about 5 GB). In Docker the API
# reaches it at http://host.docker.internal:11434 (set in docker-compose.yml).
# AI_PROVIDER=off hides the feature.
# OLLAMA_URL=http://localhost:11434
# AI_MAX_CHARS=12000
# AI_REQUESTS_PER_MINUTE=6

# --- Logging ---
# "json" (default) for Docker and log tools; "console" is easier to read in a terminal
# LOG_FORMAT=console
# LOG_LEVEL=INFO

# --- Browser access and rate limits ---
# Web pages allowed to call the API (the Vite dev server by default). A JSON list:
# CORS_ORIGINS=["http://localhost:5173"]
# LOGIN_ATTEMPTS_PER_MINUTE=5
# COMMENTS_PER_MINUTE=10

# --- API ---
# Host port for the API (change if 8000 is already in use)
API_PORT=8000
